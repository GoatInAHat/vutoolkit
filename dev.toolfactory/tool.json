{
  "$schema": "./tool.schema.json",
  "schemaVersion": 1,
  "identity": "plugin.json",
  "binding": "typescript",
  "surfaces": [
    "skill",
    "clawhub",
    "mcp",
    "cli",
    "npm",
    "openclaw-native",
    "web",
    "browser-extension"
  ],
  "bundle": {
    "runtime": "package"
  },
  "config": {
    "type": "object",
    "properties": {
      "VUTOOLKIT_CREDENTIAL_STORE": {
        "type": "string",
        "enum": ["file", "openclaw"],
        "default": "file",
        "description": "Credential cache backend. Select openclaw on OpenClaw hosts to store sessions and Graph tokens in the native vault; file preserves standalone 0600 storage."
      }
    },
    "additionalProperties": false
  },
  "tests": {
    "examples": {},
    "live": {
      "credentials": ["VUTOOLKIT_LIVE"],
      "ci": false
    }
  }
}
