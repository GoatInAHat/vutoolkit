# Generated by toolfactory from dev.toolfactory/tool.json `config`. Copy to `.env` and fill in.

# Credential cache backend. Select openclaw on OpenClaw hosts to store sessions and Graph tokens in the native vault; file preserves standalone 0600 storage. (optional)
VUTOOLKIT_CREDENTIAL_STORE=

# Release credentials (repository secrets; `toolfactory bootstrap-repo` pushes them from .env,
# `toolfactory secrets-usage status` explains each). Leave one empty to skip that registry.

# npm: https://www.npmjs.com/settings/~/tokens
NPM_TOKEN=

# clawhub-package: https://clawhub.ai
CLAWHUB_TOKEN=

# clawhub-skill: https://clawhub.ai
CLAWHUB_TOKEN=

# chrome: https://chrome.google.com/webstore/devconsole
CHROME_EXTENSION_ID=
CHROME_PUBLISHER_ID=
CHROME_SERVICE_ACCOUNT_CLIENT_EMAIL=
CHROME_SERVICE_ACCOUNT_PRIVATE_KEY=

# firefox: https://addons.mozilla.org/developers/addon/api/key/
FIREFOX_EXTENSION_ID=
FIREFOX_JWT_ISSUER=
FIREFOX_JWT_SECRET=

# edge: https://partner.microsoft.com/dashboard/microsoftedge/publishapi
EDGE_PRODUCT_ID=
EDGE_CLIENT_ID=
EDGE_API_KEY=
