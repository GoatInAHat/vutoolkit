{
  "name": "vutoolkit",
  "version": "0.4.1",
  "description": "Universal toolkit for Vanderbilt student life - OneVU SSO and passkey sessions, what-if grades, YES tools; built for AI agents first.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoatInAHat/vutoolkit.git"
  },
  "keywords": [
    "vanderbilt",
    "yes",
    "sso",
    "passkey",
    "gpa",
    "degree-planner"
  ],
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:live": "node scripts/test-live.mjs",
    "relink": "npm -C web run build && openclaw plugins install --link hosts/openclaw --force --accept-capabilities",
    "postbuild": "node scripts/prepare-package.mjs",
    "prepack": "node scripts/prepare-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "commander": "^15.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "toolfactory": "0.4.2",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  },
  "bin": {
    "vutoolkit": "./dist/toolfactory/cli.js"
  },
  "files": [
    "dist",
    "src",
    "schemas",
    "web/dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  }
}
